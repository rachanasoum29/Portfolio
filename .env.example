# Copy this file to .env and replace the placeholder values.
# .env is gitignored. Do not commit database credentials.

# PostgreSQL connection string used by Prisma and the Next.js server.
# Local example:
# postgresql://postgres:postgres@localhost:5432/portfolio?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/portfolio?schema=public"

# Random string of at least 32 characters. Signs the admin session cookie.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Used only by `npm run admin:create`.
# Remove ADMIN_PASSWORD after the account exists. The app never reads it to sign in.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
